{
  "name": "printio",
  "private": true,
  "version": "0.1.0",
  "description": "Printio - multi-tenant print management platform (cloud web app + on-prem Windows print agent)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @printio/web dev",
    "build:web": "pnpm --filter @printio/web build",
    "dev:agent": "pnpm --filter @printio/agent dev",
    "build:agent": "pnpm --filter @printio/agent build",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
