# Copy to .env next to package.json (apps/gateway/.env). Never commit the real file.

# The Printio web app (Vercel). No trailing slash needed.
WEB_BASE_URL=https://your-printio-app.vercel.app

# Must equal GATEWAY_SHARED_SECRET on the web app. At least 32 characters, e.g. `openssl rand -base64 48`.
GATEWAY_SHARED_SECRET=

# Supabase project (same one the web app uses). The service-role key lets the gateway upload to the
# print-jobs bucket under gateway-intake/. Keep it secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Device addresses are u-<token>.<BASE_DOMAIN>. Must equal GATEWAY_BASE_DOMAIN on the web app.
BASE_DOMAIN=szvtech.org

# Optional
PORT=8631
PRINTER_NAME=Printio
# Upload limit in MB (the org's limit; contract default is 50).
MAX_UPLOAD_MB=50
LOG_LEVEL=info
