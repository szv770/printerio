# PrintOS Agent configuration.
#
# Copy this file to `.env` (a `.env` file is git-ignored by the repo root
# .gitignore) - `src/index.ts` loads it automatically on startup (console
# mode and as an installed Windows Service alike), via a path resolved
# relative to this package, not process.cwd(), so it works the same way
# regardless of how the Agent was invoked. It never overrides a variable
# that's already set in the real environment, so for production you can
# still set these as real Windows environment variables instead (System
# Properties -> Environment Variables, or via `node-windows`'s service `env`
# option - see src/windows-service.ts) if you'd rather not keep a .env file
# on disk at all - either approach works, and they compose (a real env var
# always wins over anything in .env).
#
# PRINTOS_AGENT_ID / PRINTOS_AGENT_SECRET are normally NOT set by hand here.
# They are produced once by `printos-agent register --code=<enrollmentCode>`
# (see docs/agent-api.md `POST /api/agents/register`) and then persisted to
# local secure storage (src/secure-storage.ts) - the `start` command loads
# them from there automatically. Setting them here is only useful for
# advanced/CI scenarios where you want to bypass secure-storage entirely.

# --- Required ---

# Base URL of the PrintOS cloud API (the Next.js app), no trailing slash.
PRINTOS_API_URL=https://printos.example.org

# --- Populated by `register`, or overridden here for advanced use ---

# PRINTOS_AGENT_ID=
# PRINTOS_AGENT_SECRET=

# --- Optional (defaults shown) ---

# Where the agent keeps its local state: downloaded PDFs, the local job
# queue/state file, secure-storage fallback file (non-Windows only), and
# logs. Default on Windows: C:\ProgramData\PrintOS\Agent
# Default elsewhere (dev only - this agent is Windows-targeted in prod):
# ./.printos-agent-data
# PRINTOS_LOCAL_STORAGE_PATH=C:\ProgramData\PrintOS\Agent

# debug | info | warn | error
PRINTOS_LOG_LEVEL=info

# Soft cap on how much space downloaded job files + logs may use under
# PRINTOS_LOCAL_STORAGE_PATH before the agent starts refusing new downloads
# and logging loudly (does not retroactively delete anything on its own -
# see CLEAR_AGENT_TEMP_FILES in docs/architecture.md sec 12).
PRINTOS_MAX_LOCAL_STORAGE_MB=2048

# How often (seconds) the agent polls heartbeat / claimable jobs / commands.
# Matches the default documented in docs/agent-api.md.
PRINTOS_POLL_INTERVAL_SECONDS=15

# Ceiling (seconds) the outer poll loop backs off to during a sustained cloud
# outage. When heartbeat, commands, AND claimable-jobs all fail to reach the
# cloud in the same cycle (each already retried on its own per docs/agent-
# api.md before that counts as a failure), the agent doubles its next sleep
# each further such cycle instead of retrying every PRINTOS_POLL_INTERVAL_
# SECONDS for the whole outage - capped here, and reset back to
# PRINTOS_POLL_INTERVAL_SECONDS immediately on the next fully-successful
# cycle. 300s (5 minutes) bounds the worst case (an Agent that only notices
# the cloud is back up to 5 minutes late) while still cutting a whole fleet's
# request rate sharply during a real outage. Does not change a healthy
# Agent's cadence at all - only ever engages once a cycle has actually failed
# completely.
PRINTOS_MAX_POLL_INTERVAL_SECONDS=300

# Path to SumatraPDF.exe. Defaults to "SumatraPDF.exe" (resolved via PATH).
# Set an absolute path if it is not on PATH.
PRINTOS_SUMATRA_PATH=SumatraPDF.exe

# How often (ms) to poll Get-PrintJob while waiting for a submitted job to
# leave the spooler, and how long (seconds) to wait before giving up and
# reporting `failed` with a timeout message.
PRINTOS_SPOOLER_POLL_INTERVAL_MS=2000
PRINTOS_SPOOLER_TIMEOUT_SECONDS=600

# Generic SumatraPDF -print-settings tokens applied to every job in addition
# to the per-job tokens derived from the resolved print request (color mode,
# duplex, paper size, copies). See src/print-executor.ts - only these exact
# allow-listed values are ever accepted.
# fit | shrink | noscale
PRINTOS_PRINT_FIT_MODE=fit
# true | false - add the `collate` token whenever copies > 1
PRINTOS_COLLATE_MULTI_COPY=true
