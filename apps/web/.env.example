# Supabase (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER prefix with NEXT_PUBLIC_, never sent to the browser, never
# logged. Used only in lib/supabase/service-role.ts for the small explicit set
# of operations documented in docs/architecture.md sec 2.2/3.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# One-time single-org bootstrap (docs/architecture.md sec 2, adjusted per this
# session's single-org-first scope). On this exact email's first successful
# Google sign-in, IF no organization exists yet, the server creates one
# organization and makes this user its org_admin. Leave PRINTIO_BOOTSTRAP_ADMIN_EMAIL
# unset (or already-bootstrapped) to disable this path entirely - it never
# fires again once any organization exists. This email's own domain also seeds
# that organization's allowed_domains (docs/architecture.md sec 19), so
# domain-restricted sign-in works with no extra configuration for the
# single-org case - editable afterward from /admin/settings.
PRINTIO_BOOTSTRAP_ADMIN_EMAIL=you@example.org
PRINTIO_BOOTSTRAP_ORG_NAME="My Print Shop"

# Shared secret the Vercel Cron sweep route checks (Authorization: Bearer <this>).
PRINTIO_CRON_SECRET=generate-a-random-string

# Base URL of this deployment (used to build absolute links in emails/invitations later).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IPP gateway (native printing from the OS print dialog) - optional until apps/gateway is deployed.
# Shared secret the gateway sends as `Authorization: Bearer <this>` to /api/gateway/* (min 32 chars; the same value
# is set as GATEWAY_SHARED_SECRET on the gateway). Generate with: openssl rand -hex 32
GATEWAY_SHARED_SECRET=
# Domain the per-device addresses live under: https://u-<token>.<this>/ipp/print (e.g. szvtech.org).
GATEWAY_BASE_DOMAIN=

# Optional. Minutes a job may stay "waiting for the printer" (printer off/offline) before it is marked failed with a
# Try again button. Default 120 (2 hours); allowed 1 - 10080.
# PRINTIO_WAITING_WINDOW_MINUTES=120
